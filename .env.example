# Supabase (leave empty to run in demo mode with in-memory sample data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider key (Anthropic). Server-side only. Leave empty to use the offline estimator.
AI_API_KEY=
# Optional: override the model
AI_MODEL=claude-sonnet-5-5

# Free alternative: Google Gemini key from https://aistudio.google.com/apikey (used only when AI_API_KEY is empty)
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.5-flash
